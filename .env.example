# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/nichanue?retryWrites=true&w=majority
MONGODB_DB=nichanue

# Application settings
NICHANUE_FEE_KES=50

# Paystack — keep secret keys server-side
PAYSTACK_SECRET_KEY=sk_live_replace_me
PAYSTACK_PUBLIC_KEY=pk_live_replace_me
PAYSTACK_CALLBACK_URL=https://YOUR_VERCEL_DOMAIN.vercel.app/

# Talk Sasa — keep the API key server-side
TALKSASA_API_KEY=replace_with_talksasa_api_key
TALKSASA_SENDER_ID=YOUR_SENDER_ID
TALKSASA_SMS_URL=https://bulksms.talksasa.com/api/v3/sms/send

# Long random secret used to hash one-time verification codes
VERIFICATION_CODE_SECRET=replace_with_a_long_random_secret

# Optional local development settings
# CORS_ORIGIN=http://localhost:5173
# VITE_API_URL=http://localhost:5000/api