# ================================
# NICHANUE PRODUCTION ENVIRONMENT
# ================================
# Never commit a real .env file or real API credentials.

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/nichanue?retryWrites=true&w=majority
MONGODB_DB=nichanue

# Application
NICHANUE_FEE_KES=50
NODE_ENV=production

# Paystack: SERVER ONLY, never use VITE_ prefix
PAYSTACK_SECRET_KEY=sk_live_REPLACE_WITH_YOUR_SECRET_KEY
PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_WITH_YOUR_PUBLIC_KEY
PAYSTACK_CALLBACK_URL=https://YOUR_VERCEL_DOMAIN.vercel.app/

# Talk Sasa: SERVER ONLY
TALKSASA_API_KEY=REPLACE_WITH_YOUR_TALKSASA_API_KEY
TALKSASA_SENDER_ID=YOUR_APPROVED_SENDER_ID
TALKSASA_SMS_URL=https://bulksms.talksasa.com/api/v3/sms/send

# Long random secret for hashing one-time verification codes
# Generate with: openssl rand -base64 48
VERIFICATION_CODE_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Optional: only needed when the API is hosted on a different origin during local development
# CORS_ORIGIN=http://localhost:5173
# VITE_API_URL=http://localhost:5000/api
